{
  "expo": {
    "name": "Click Note Taker",
    "slug": "click-note-taker",
    "version": "1.1.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clickecommerce.clicknotetaker",
      "buildNumber": "19",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs access to your microphone to record voice notes.",
        "NSFaceIDUsageDescription": "This app uses Face ID to securely unlock the app."
      }
    },
    "android": {
      "versionCode": 19,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2C5282"
      },
      "package": "com.clickecommerce.clicknotetaker",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Click Note Taker to use Face ID to unlock the app."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Click Note Taker to record voice notes.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Click Note Taker to record and privately transcribe voice notes on this device.",
          "speechRecognitionPermission": "Allow Click Note Taker to transcribe voice notes on this device.",
          "androidSpeechServicePackages": [
            "com.google.android.as",
            "com.google.android.tts",
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#2C5282"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bcee509b-61b8-45c8-acfa-9e1eca4290a0"
      }
    },
    "owner": "yolodating"
  }
}
